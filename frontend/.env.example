# Copy to .env.local and adjust.

# Mock mode (default): the service layer in src/lib/api.ts generates
# scans with the rule-based mock engine (src/lib/mock-scan.ts) and
# serves history from memory. Set to "false" to call the real backend.
NEXT_PUBLIC_USE_MOCK=true

# Legacy alias from an earlier naming of the flag above. Setting
# either variable to "false" switches to the real backend; the
# canonical name is NEXT_PUBLIC_USE_MOCK.
# NEXT_PUBLIC_USE_MOCK_API=

# Base URL of the backend that serves POST /api/scan and GET /api/history.
# Only used when NEXT_PUBLIC_USE_MOCK=false.
# Example: NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=

# Public URL of this deployed site. Used only to build absolute
# Open Graph / social-share URLs; safe to leave unset locally.
# NEXT_PUBLIC_SITE_URL=https://your-deployment-url

# Note: NEXT_PUBLIC_ variables are visible to anyone who loads the
# site. Never put API keys, tokens or other secrets in them — the
# backend must keep secrets server-side and enforce its own auth,
# rate limiting and validation.

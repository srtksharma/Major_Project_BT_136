# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS Configuration (comma-separated origins or * for all)
CORS_ORIGINS=*

# Paths (defaults are relative to project structure)
# DATABASE_PATH=data/linklens.db
# MODEL_PATH=../models/phishing_url_only_model.joblib

# Rate Limiting
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_RETRY_AFTER=30

# Max history items to return
MAX_HISTORY_LIMIT=1000
